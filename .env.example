# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)

# [필수] SentinelOne 콘솔 API 기본 URL (끝에 /web/api/v2.1 포함)
S1_API_URL=https://your-console.sentinelone.net/web/api/v2.1
# [필수] SentinelOne API 토큰 (서비스 유저 토큰 권장)
S1_API_TOKEN=

# --- 위협 폴링 ---
# 폴링 주기(초)
S1_POLL_INTERVAL=30
# 한 번 폴링할 때 가져올 미해결 위협 수 (최신순)
S1_THREAT_FETCH_LIMIT=20
# 처리한 위협 ID 를 저장하는 파일 (재시작해도 중복 분석 방지)
S1_STATE_FILE=state/seen_threats.json

# --- Deep Visibility ---
# DV 조회 시간 범위(시간). 위협 생성 시각 기준 전후로 조회합니다.
S1_DV_LOOKBACK_HOURS=24
# S1QL 쿼리 템플릿. {storyline_id} 가 치환됩니다.
S1_DV_QUERY_TEMPLATE=storyline = "{storyline_id}"
# 쿼리 상태 확인 간격(초)과 최대 대기 시간(초)
S1_DV_POLL_SECONDS=3
S1_DV_TIMEOUT_SECONDS=90
# 수집할 최대 DV 이벤트 수 (페이지네이션 상한)
S1_DV_MAX_EVENTS=5000

# --- HTTP ---
S1_HTTP_TIMEOUT=30
S1_HTTP_RETRIES=3
# 429(요청 과다) 응답 시 대기 후 재시도 횟수 (Retry-After 가 없으면 15초부터 2배씩, 최대 120초)
S1_RATE_LIMIT_RETRIES=4
# DV 쿼리를 연속으로 만들 때 최소 간격(초)
S1_DV_MIN_INTERVAL=10

# --- 선택: 위협 인텔리전스 Enrichment (비워두면 건너뜀) ---
VT_API_KEY=
ABUSEIPDB_API_KEY=
# 위협 1건당 외부 TI 조회 최대 횟수 (무료 API 쿼터 보호)
ENRICH_MAX_LOOKUPS=10

# --- 선택: 분석 결과 JSON 저장 디렉터리 (비워두면 저장 안 함) ---
REPORT_DIR=reports
# true 로 두면 JSON 리포트에 DV 원본 이벤트도 함께 저장 (필드명 확인/룰 튜닝용)
REPORT_RAW_EVENTS=false

# --- 선택: AI 참고 판정 (Claude API, 정밀 분석 탭에서 사용) ---
# https://platform.claude.com 에서 발급. 비워두면 AI 판정 옵션이 비활성화됩니다.
ANTHROPIC_API_KEY=
# 사용할 모델과 추론 강도(low/medium/high/xhigh/max)
AI_MODEL=claude-opus-5-5
AI_EFFORT=high

# --- 웹 화면 (python -m s1triage --web) ---
# 127.0.0.1 이면 이 PC 에서만 접속 가능 (권장). 인증이 없으니 0.0.0.0 으로 바꾸지 마세요.
WEB_HOST=127.0.0.1
WEB_PORT=8080
